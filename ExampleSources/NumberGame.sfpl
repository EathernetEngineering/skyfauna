

class Main(Game) {
	public static Game(@str : arg)(null) {
		@stdout << write << "Guess a number. If number is higher or lower, it will be specified. Only use numbers. You get 3 guesses. The number is between and can be 0 and 9.";
		int : [turns, times, failsafe] = 0;
		@str : playAgain = "Yes";

		while (playAgain ~~ "Yes") {
			if (times == 1) {
				@stdout << write << "\n\nGuess a number.";
			}
			int : guessNumber;
			randint(0, 10)(guessNumber);
			turns = 0;
			while (turns >= 2) {
				int : userNumber;
				@stdin >> int >> read >> userNumber # InputAdaptionFault : [](InputAdaptionFault : iaf)(null){NotNumber(iaf)()};
				if (userNumber > guessNumber) {
					@stdout << write << "\nThe number is lower than " << userNumber << ".";
					turns++;
				} else if (userNumber < guessNumber) {
					@stdout << write << "\nThe number is higher than " << userNumber << ".";
					turns++;
				} else if (userNumber == guessNumber) {
					@stdout << write << "\nYou got it! The answer was " << guessNumber << ".";
					[failsafe, turns] = [1, 3];
				}
			}
			if (failsafe == 0) {
				@stdout << write << "\nYou didn't guess it in enough turns. The number was " << guessNumber << ".";
			}
			@stdout << write << "/nPlay again? (Use /"Yes/" or /"No/")";
			@stdin >> read >> playAgain;
			if (playAgain ~~ "Yes") {
				[times, failsafe] = [1, 0];
			}
		}
		return @SUCCESS;
	}
	static NotNumber(fault : iaf)(null) {
		@stdout << write << "Not a number. Try again";
		iaf.what()();
	}
}
