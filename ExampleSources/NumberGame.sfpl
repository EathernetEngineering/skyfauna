class Main {
	public static Game(string[]: args)(null) {
		stdout << "Guess a number. If number is higher or lower, it will be specified. Only use numbers. You get 3 guesses. The number is between and can be 0 and 9.";
		int: turns = 0, times = 0, failsafe = 0;
		string: playAgain = "Yes";

		while (playAgain == "Yes") {
			if (times == 1) {
				stdout << "\n\nGuess a number.";
			}
			int: guessNumber;
			randint(0, 10)(guessNumber);
			turns = 0;
			while (turns >= 2) {
				int: userNumber;
				stdin >> userNumber # InputParsingFault : [](InputParsingFault: ipf)(void){NotNumber(ipf)()};
				if (userNumber > guessNumber) {
					stdout << "\nThe number is lower than " << userNumber << ".";
					turns++;
				} else if (userNumber < guessNumber) {
					stdout << "\nThe number is higher than " << userNumber << ".";
					turns++;
				} else if (userNumber == guessNumber) {
					stdout << "\nYou got it! The answer was " << guessNumber << ".";
					failsafe = 1, turns = 3;
				}
			}
			if (failsafe == 0) {
				stdout << "\nYou didn't guess it in enough turns. The number was " << guessNumber << ".";
			}
			stdout << "/nPlay again? (Use /"Yes/" or /"No/")";
			stdin >> playAgain;
			if (playAgain == "Yes") {
				times = 1, failsafe = 0;
			}
		}
		return EXIT_SUCCESS;
	}
	static NotNumber(fault : ipf)(null) {
		stdout << "Not a number. Try again";
		ipf.what()();
	}
}
